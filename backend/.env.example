# Application Environment
NODE_ENV=development
PORT=3000

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://localhost:5432/devoc_os
TEST_DATABASE_URL=postgresql://localhost:5432/devoc_os_test

# Authentication & Security
JWT_SECRET=devoc_os_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=24h

# Logging & CORS
LOG_LEVEL=info
CORS_ORIGIN=*

{
  "name": "devoc-os-workspace",
  "version": "1.0.0",
  "description": "Enterprise-grade, multi-tenant Business Operating System for DeVoc — Monorepo Workspace",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev:backend",
    "dev:backend": "npm --workspace=backend run dev",
    "dev:frontend": "npm --workspace=frontend run dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "npm --workspace=backend run build",
    "build:frontend": "npm --workspace=frontend run build",
    "start": "npm --workspace=backend start",
    "start:backend": "npm --workspace=backend start",
    "start:frontend": "npm --workspace=frontend start",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "npm --workspace=backend test",
    "test:frontend": "npm --workspace=frontend test",
    "test:watch:backend": "npm --workspace=backend run test:watch",
    "test:watch:frontend": "npm --workspace=frontend run test:watch",
    "typecheck": "npm run typecheck:backend && npm run typecheck:frontend",
    "typecheck:backend": "npm --workspace=backend run typecheck",
    "typecheck:frontend": "npm --workspace=frontend run typecheck",
    "migrate": "npm --workspace=backend run migrate",
    "migrate:down": "npm --workspace=backend run migrate:down",
    "migrate:reset": "npm --workspace=backend run migrate:reset",
    "seed": "npm --workspace=backend run seed"
  },
  "keywords": [
    "multi-tenant",
    "enterprise",
    "operating-system",
    "devoc"
  ],
  "author": "DeVoc Team",
  "license": "ISC"
}
